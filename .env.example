# Public address of the app, no trailing slash
APP_URL=https://flow.graphixdesign.agency
# MySQL (on Hostinger the app connects to 127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# 64 random hex characters. Encrypts stored API keys. Never change it after first use.
SECRET_KEY=
# One-time token for creating the first owner account at /setup?token=...
SETUP_TOKEN=
# Shared secret for the every-minute cron call to /api/cron/tick?key=...
CRON_SECRET=
